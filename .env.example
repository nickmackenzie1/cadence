# Copy to .env on the NAS (deploy.sh does this automatically on first run). Never commit .env.
TZ=America/Toronto
APP_USERNAME=cadence
APP_PASSWORD=change-me
# Optional: enables AI extraction + AI recap summaries
ANTHROPIC_API_KEY=

# Optional: send songs you hear on the radio in Cadence (two minutes or more) to your ListenBrainz account.
# Your token is on listenbrainz.org -> Settings. Previews and podcasts aren't sent.
LISTENBRAINZ_TOKEN=

# Optional: film and TV pictures for the film and TV themes (Jurassic Park, The Simpsons…), from TMDB.
# A free key from themoviedb.org -> Settings -> API. "This product uses the TMDB API but is not endorsed or certified by TMDB."
TMDB_API_KEY=

# Optional: game pictures for the game themes (Breath of the Wild, NES, Cyberpunk…), from TheGamesDB.
# Request a key on forums.thegamesdb.net (their API section). Each game is looked up once a month.
THEGAMESDB_API_KEY=
