# Copy to .env on the NAS (deploy.sh does this automatically on first run). Never commit .env.
TZ=America/Toronto
APP_USERNAME=cadence
APP_PASSWORD=change-me
# Optional: enables AI extraction + AI recap summaries
ANTHROPIC_API_KEY=

# Optional: send songs you hear on the radio in Cadence (two minutes or more) to your ListenBrainz account.
# Your token is on listenbrainz.org -> Settings. Previews and podcasts aren't sent.
LISTENBRAINZ_TOKEN=

# Optional: also (or instead) send them to your own Koito scrobbler on your network (github.com/gabehf/koito).
# KOITO_URL is the address you open Koito at; KOITO_TOKEN is an API key made in Koito's settings.
KOITO_URL=
KOITO_TOKEN=

# Optional: Last.fm listener counts, charts and similar artists in Music Radar. From 1 December 2026 a key only works
# with a Last.fm Pro account; without one Radar uses ListenBrainz's counts and charts (free, no key), so leave it empty.
# LASTFM_API_KEY=
# ListenBrainz has fewer listeners than Last.fm; its counts are multiplied by this to compare with Last.fm-sized limits
# RADAR_LB_SCALE=25

# Optional: film and TV pictures for the film and TV themes (Jurassic Park, The Simpsons…), from TMDB.
# A free key from themoviedb.org -> Settings -> API. "This product uses the TMDB API but is not endorsed or certified by TMDB."
TMDB_API_KEY=

# Optional: game pictures for the game themes (Breath of the Wild, NES, Cyberpunk…), from TheGamesDB.
# Request a key on forums.thegamesdb.net (their API section). Each game is looked up once a month.
THEGAMESDB_API_KEY=

# Optional: your Discogs records in Music Radar ("In your records", your wantlist next to Want to hear, For you learning
# from what you own). discogs.com -> Settings -> Developers -> Generate new token.
DISCOGS_TOKEN=

# Optional: "More like this" on the Watch list and artist pages, from TasteDive. Request a free key at
# tastedive.com/read/api. Answers are kept 30 days on the NAS.
TASTEDIVE_API_KEY=
